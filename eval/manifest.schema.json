{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airlock.local/eval/manifest.schema.json",
  "title": "Airlock evaluation manifest",
  "$comment": "Contract v2.0.0: case field renamed attack_id -> attack_type (see docs/phase1/MANIFEST_MIGRATION_v2.md). v1 manifests are rejected with unknown-property errors.",
  "description": "Contract for reproducible Airlock benchmark case sets. No measured results live in a manifest.",
  "type": "object",
  "required": ["manifest_version", "seed", "split", "generator_commit", "cases", "sha256"],
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "description": "Manifest contract version (semver).",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "seed": {
      "description": "RNG seed used by the case generator.",
      "type": "integer",
      "minimum": 0
    },
    "split": {
      "description": "Which benchmark split this manifest describes.",
      "type": "string",
      "enum": ["dev", "test"]
    },
    "generator_commit": {
      "description": "VCS commit of the generator that produced the cases (or 'template').",
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "description": "Hex SHA-256 over the canonical case payload (see eval/README.md). 'template' manifests use a placeholder until generated.",
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "description": "Benchmark cases. Must be non-empty in a real manifest.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["case_id", "base_doc_id", "variant", "artifacts", "ground_truth", "expected_verdict"],
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "base_doc_id": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": "string",
          "enum": ["clean", "attack", "ambiguous", "failure"]
        },
        "attack_type": {
          "description": "Attack catalogue entry, A01-A16, or null when not applicable.",
          "type": ["string", "null"],
          "pattern": "^A(0[1-9]|1[0-6])$"
        },
        "artifacts": {
          "description": "Relative artifact paths (safe path rules, see eval/README.md).",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "ground_truth": {
          "description": "Trusted expected facts for this case.",
          "type": "object",
          "additionalProperties": false,
          "required": ["vendor_id", "invoice_total", "currency"],
          "properties": {
            "vendor_id": { "type": "string", "minLength": 1 },
            "invoice_total": { "type": "number" },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "due_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "line_item_count": { "type": "integer", "minimum": 0 }
          }
        },
        "expected_verdict": {
          "type": "string",
          "enum": ["ALLOW_PROPOSAL", "ESCALATE", "DENY"]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
