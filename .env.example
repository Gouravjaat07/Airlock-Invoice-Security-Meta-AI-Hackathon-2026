# Airlock environment template — placeholders and comments ONLY.
# Copy to `.env` for local use. Never commit `.env` or real credentials.
# Phase 1 tools never require `.env` to exist and never print secret values.

# --- Meta Model API (Muse Spark 1.3 runtime) ---
# API key for the deployed Airlock application (NOT the Contributor dev key).
MODEL_API_KEY=
# Base URL of the Meta Model API.
META_API_BASE=https://api.meta.ai/v1
# Runtime model. Must be `muse-spark-1.3`; never `muse-spark-1.3-contributor`
# (Contributor mode is for development assistance only and must not receive
# real or confidential Airlock data).
SPARK_MODEL=muse-spark-1.3
# Voice transcription model (Meta Model API file-transcription endpoint).
VOICE_MODEL=muse-voice-transcribe-1.0
# Segmentation model (Meta Model API Responses API, streamed lane grammar).
SAM_MODEL=sam-3.1

# --- Baseten (optional hosted Muse Spark Open experiments) ---
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026

# --- Local Glimmer reader (Phase 2+, only if hardware-verified) ---
# Local OpenAI-compatible endpoint served by the local inference runtime.
# Plain http is accepted for loopback hosts only; use https otherwise.
GLIMMER_BASE_URL=http://127.0.0.1:8081/v1
# Served model name reported by the local runtime.
GLIMMER_MODEL=muse-glimmer
# Optional: only when the local runtime requires authentication.
GLIMMER_API_KEY=

# --- Phase 3 provider selection (explicit; fixture/mock are dev/test only) ---
# fixture | spark | spark-open | glimmer
AIRLOCK_READER_PROVIDER=fixture
# mock | meta
AIRLOCK_VOICE_PROVIDER=mock
# mock | sam
AIRLOCK_VISION_PROVIDER=mock
# Bounded timeout profiles (seconds) and call controls.
AIRLOCK_PROVIDER_CONNECT_TIMEOUT_S=10
AIRLOCK_EXTRACTION_TIMEOUT_S=180
AIRLOCK_VOICE_TIMEOUT_S=300
AIRLOCK_SAM_TIMEOUT_S=300
AIRLOCK_PROVIDER_MAX_INFLIGHT=2
AIRLOCK_PROVIDER_MAX_RETRIES=2
AIRLOCK_SPARK_MAX_OUTPUT_TOKENS=4096

# --- Application secrets (Phase 2; generated by scripts/setup_airlock.py) ---
# Argon2id hash of the owner PIN. Never store the PIN itself.
AIRLOCK_PIN_HASH=
# Random session secret for authenticated owner sessions.
AIRLOCK_SESSION_SECRET=
# Random key (utf-8) for HMAC bank-fingerprinting. Never commit.
AIRLOCK_BANK_HASH_KEY=

# --- Application storage (Phase 2) ---
AIRLOCK_DB_PATH=./data/airlock.db
AIRLOCK_BLOB_DIR=./data/blobs

# --- Phase 2 runtime flags ---
# development | test | production
AIRLOCK_ENV=development
# Synthetic fixture reader (dev/test/demo only; never production).
AIRLOCK_FIXTURE_READER=0
# Dev-only evaluation endpoints (never production).
AIRLOCK_ENABLE_EVAL_API=0
# Loopback-only insecure-cookie escape hatch (never production).
AIRLOCK_ALLOW_INSECURE_COOKIES=0
